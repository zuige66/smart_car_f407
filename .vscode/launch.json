{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "STM32 Smart Car Debug",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "servertype": "stlink",
      "serverpath": "D:/develop/STM32CubeCLT_1.21.0/STLink-gdb-server/bin/ST-LINK_gdbserver.exe",
      "stm32cubeprogrammer": "D:/develop/stm32cubeprogrammer/bin",
      "armToolchainPath": "D:/develop/STM32CubeCLT_1.21.0/GNU-tools-for-STM32/bin",
      "gdbPath": "D:/develop/STM32CubeCLT_1.21.0/GNU-tools-for-STM32/bin/arm-none-eabi-gdb.exe",
      "executable": "${workspaceFolder}/build/Debug/smart_car.elf",
      "device": "STM32F407VETx",
      "deviceName": "STM32F407VETx",
      "interface": "swd",
      "runToEntryPoint": "main",
      "preLaunchTask": "smart_car: build Debug",
      "postRestartCommands": [
        "monitor reset"
      ]
    }
  ]
}
